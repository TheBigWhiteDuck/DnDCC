@using Microsoft.VisualStudio.Web.CodeGenerators.Mvc.Templates.BlazorIdentity.Pages.Manage
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - DnDCC</title>
    <script>
        // Apply saved theme as early as possible to avoid a flash of the default theme.
        (() => {
            try {
                const userData = localStorage.getItem('user');
                if (!userData) return;
                const user = JSON.parse(userData);
                const identifier = (user?.id || user?.userId || user?.email || user?.userName || 'guest').toString();
                const theme = localStorage.getItem(`dndcc.theme.${identifier}`) || 'default';
                if (theme && theme !== 'default') {
                    document.documentElement.dataset.theme = theme;
                }
            } catch {
                // ignore
            }
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Crimson+Pro:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" referrerpolicy="no-referrer" />
    <link rel="icon" type="image/png" href="/favicon.png">
    <style>
        :root {
            --bg: linear-gradient(135deg, #0b0c12 0%, #1b1723 45%, #2b1f1b 100%);
            --bg-image: url('/images/tlo.jpg');
            --panel: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(244, 232, 213, 0.94));
            --panel-border: rgba(92, 64, 40, 0.35);
            --accent: #d5aa63;
            --accent-dark: #3f2a1c;
            --ink: #23160e;
            --glow: rgba(213, 170, 99, 0.4);

            /* Theme palette used to remap common Tailwind amber utilities */
            --theme-text-900: #3b2314;
            --theme-text-800: #5b341d;
            --theme-text-700: #7a4528;
            --theme-text-100: #f7e9cf;
            --theme-text-50: #fff8e8;

            --theme-surface-50: #fff8e8;
            --theme-surface-100: #f9edd6;
            --theme-surface-200: #f2d9b7;

            --theme-border-rgb: 92 64 40;

            --btn-1: #d1a35c;
            --btn-2: #f0c279;
        }

        html[data-theme="night"] {
            --bg: linear-gradient(135deg, #070911 0%, #111826 45%, #1b1a24 100%);
            --bg-image: url('/images/tlo1.jpg');
            --panel: linear-gradient(180deg, rgba(17, 26, 40, 0.96), rgba(12, 18, 30, 0.96));
            --panel-border: rgba(110, 145, 198, 0.35);
            --accent: #8fb3ff;
            --accent-dark: #2f3b55;
            --ink: #e6eefc;
            --glow: rgba(143, 179, 255, 0.35);

            /* Tell the browser to render native form controls in dark mode (number spinners, selects, etc.) */
            color-scheme: dark;

            /* Text shades (mapped from Tailwind amber utilities) */
            --theme-text-900: #f5f8ff;
            --theme-text-800: #e6eefc;
            --theme-text-700: #cfe0ff;
            --theme-text-100: #e6eefc;
            --theme-text-50: #f5f8ff;

            --theme-surface-50: #0e1729;
            --theme-surface-100: #111f38;
            --theme-surface-200: #172a4a;

            --theme-border-rgb: 143 179 255;

            --btn-1: #5b8cff;
            --btn-2: #9bbcff;
        }

        /* Remap the most-used Tailwind amber utilities so the theme affects the whole app.
           Scoped to html[data-theme] to avoid breaking default styling. */
        html[data-theme] .text-amber-900 { color: var(--theme-text-900) !important; }
        html[data-theme] .text-amber-800 { color: var(--theme-text-800) !important; }
        html[data-theme] .text-amber-700 { color: var(--theme-text-700) !important; }
        html[data-theme] .text-amber-100 { color: var(--theme-text-100) !important; }
        html[data-theme] .text-amber-50 { color: var(--theme-text-50) !important; }

        html[data-theme] .bg-amber-50 { background-color: var(--theme-surface-50) !important; }
        html[data-theme] .bg-amber-100 { background-color: var(--theme-surface-100) !important; }
        html[data-theme] .bg-amber-200 { background-color: var(--theme-surface-200) !important; }

        /* Common translucent whites used as "window" backgrounds */
        html[data-theme] .bg-white\/60 { background-color: rgb(14 23 41 / 0.6) !important; }
        html[data-theme] .bg-white\/70 { background-color: rgb(14 23 41 / 0.7) !important; }
        html[data-theme] .bg-white\/80 { background-color: rgb(14 23 41 / 0.8) !important; }
        html[data-theme] .bg-white\/90 { background-color: rgb(14 23 41 / 0.9) !important; }

        /* Gradient helpers used across the views */
        html[data-theme] .from-amber-50 { --tw-gradient-from: var(--theme-surface-50) var(--tw-gradient-from-position) !important; --tw-gradient-to: rgb(0 0 0 / 0) var(--tw-gradient-to-position) !important; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important; }
        html[data-theme] .from-amber-100 { --tw-gradient-from: var(--theme-surface-100) var(--tw-gradient-from-position) !important; --tw-gradient-to: rgb(0 0 0 / 0) var(--tw-gradient-to-position) !important; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important; }
        html[data-theme] .to-amber-50 { --tw-gradient-to: var(--theme-surface-50) var(--tw-gradient-to-position) !important; }
        html[data-theme] .to-amber-100 { --tw-gradient-to: var(--theme-surface-100) var(--tw-gradient-to-position) !important; }
        html[data-theme] .to-amber-200 { --tw-gradient-to: var(--theme-surface-200) var(--tw-gradient-to-position) !important; }

        /* Opacity gradient variants used in cards */
        html[data-theme] .from-white\/70 { --tw-gradient-from: rgb(14 23 41 / 0.7) var(--tw-gradient-from-position) !important; --tw-gradient-to: rgb(0 0 0 / 0) var(--tw-gradient-to-position) !important; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important; }
        html[data-theme] .to-amber-50\/70 { --tw-gradient-to: rgb(14 23 41 / 0.7) var(--tw-gradient-to-position) !important; }
        html[data-theme] .from-amber-100\/80 { --tw-gradient-from: rgb(17 31 56 / 0.8) var(--tw-gradient-from-position) !important; --tw-gradient-to: rgb(0 0 0 / 0) var(--tw-gradient-to-position) !important; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important; }
        html[data-theme] .to-amber-50\/80 { --tw-gradient-to: rgb(14 23 41 / 0.8) var(--tw-gradient-to-position) !important; }

        /* Border opacity variants used heavily */
        html[data-theme] .border-amber-900\/20 { border-color: rgb(var(--theme-border-rgb) / 0.2) !important; }
        html[data-theme] .border-amber-900\/15 { border-color: rgb(var(--theme-border-rgb) / 0.15) !important; }
        html[data-theme] .border-amber-900\/25 { border-color: rgb(var(--theme-border-rgb) / 0.25) !important; }
        html[data-theme] .border-amber-900\/30 { border-color: rgb(var(--theme-border-rgb) / 0.3) !important; }
        html[data-theme] .border-amber-900\/40 { border-color: rgb(var(--theme-border-rgb) / 0.4) !important; }
        html[data-theme] .border-amber-700 { border-color: rgb(var(--theme-border-rgb) / 0.65) !important; }

        /* Make form controls readable on dark surfaces */
        html[data-theme] input,
        html[data-theme] select,
        html[data-theme] textarea {
            color: var(--theme-text-900) !important;
            background-color: var(--theme-surface-50) !important;
        }
        html[data-theme="night"] input,
        html[data-theme="night"] select,
        html[data-theme="night"] textarea {
            color-scheme: dark;
        }

        /* Chrome/Edge autofill can force a light background; keep it consistent with dark theme */
        html[data-theme="night"] input:-webkit-autofill,
        html[data-theme="night"] textarea:-webkit-autofill,
        html[data-theme="night"] select:-webkit-autofill {
            -webkit-text-fill-color: var(--theme-text-900) !important;
            box-shadow: 0 0 0px 1000px var(--theme-surface-50) inset !important;
            transition: background-color 9999s ease-out 0s;
        }
        html[data-theme] input::placeholder,
        html[data-theme] textarea::placeholder {
            color: rgb(185 206 255 / 0.75) !important;
        }
        body {
            font-family: 'Crimson Pro', serif;
            background: center/cover no-repeat var(--bg-image), var(--bg);
            color: var(--ink);
        }
        html[data-theme="night"] body {
            color: var(--theme-text-900);
        }
        .title-font { font-family: 'Cinzel', serif; letter-spacing: 0.05em; text-transform: uppercase; }
        .parchment {
            background: var(--panel);
            box-shadow: 0 18px 38px rgba(4, 4, 8, 0.35);
            border: 1px solid var(--panel-border);
            backdrop-filter: blur(6px);
        }
        .site-header {
            background: linear-gradient(135deg, rgba(8, 10, 16, 0.92), rgba(16, 13, 20, 0.82));
            border-bottom: 1px solid rgba(213, 170, 99, 0.25);
            box-shadow: 0 10px 30px rgba(4, 4, 8, 0.45);
        }
        .site-footer {
            background: linear-gradient(120deg, rgba(5, 6, 9, 0.95), rgba(18, 13, 18, 0.9));
            letter-spacing: 0.08em;
        }
        .nav-link {
            border-radius: 999px;
            border: 1px solid rgba(213, 170, 99, 0.35);
            background: rgba(10, 10, 16, 0.55);
            transition: color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        }
        .nav-link:hover {
            color: var(--accent);
            transform: translateY(-2px);
            border-color: rgba(213, 170, 99, 0.6);
            box-shadow: 0 10px 20px rgba(10, 10, 16, 0.4);
        }
        .nav-link:focus-visible {
            outline: 2px solid var(--glow);
            outline-offset: 2px;
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--btn-1), var(--btn-2));
            color: #2b1c10;
            box-shadow: 0 16px 26px rgba(9, 6, 3, 0.35);
        }
        .btn-primary:hover { filter: brightness(1.05); }
        .modal-backdrop {
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(4px);
        }
        .parchment { width: 100%; box-sizing: border-box; }
        details { display: block; width: 100%; }
        summary { list-style: none; }
        summary::-webkit-details-marker { display: none; }

        .chat-fab {
            width: 56px;
            height: 56px;
            border-radius: 9999px;
            background: linear-gradient(135deg, var(--btn-1), var(--btn-2));
            color: #2b1c10;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 18px 28px rgba(0,0,0,0.4);
            animation: chatPulse 2.2s ease-in-out infinite;
        }
        .chat-hint {
            background: rgba(8, 8, 12, 0.8);
            color: #f7e9cf;
            padding: 0.6rem 0.9rem;
            border-radius: 9999px;
            border: 1px solid rgba(213, 170, 99, 0.45);
            font-size: 0.9rem;
            letter-spacing: 0.04em;
        }
        .chat-panel {
            width: 380px;
            max-width: calc(100vw - 2.5rem);
        }
        .chat-message {
            max-width: 85%;
            padding: 0.6rem 0.9rem;
            border-radius: 14px;
            line-height: 1.4;
            word-wrap: break-word;
        }
        .chat-message.user {
            margin-left: auto;
            background: rgba(200,155,79,0.25);
            border: 1px solid rgba(78,47,31,0.35);
        }
        .chat-message.assistant {
            background: rgba(255,255,255,0.8);
            border: 1px solid rgba(78,47,31,0.2);
        }
        html[data-theme="night"] .chat-message.assistant {
            background: rgba(255, 255, 255, 0.88);
            border: 1px solid rgba(0, 0, 0, 0.2);
            color: #141218;
        }
        html[data-theme="night"] .chat-message.user {
            background: rgba(0, 0, 0, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #f5f8ff;
        }
        @@keyframes chatPulse {
            0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(200,155,79,0.4); }
            50% { transform: scale(1.06); box-shadow: 0 0 0 14px rgba(200,155,79,0); }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body class="min-h-screen flex flex-col">
    <header class="site-header border-b border-amber-900/30 bg-black/40 backdrop-blur sticky top-0 z-40">
        <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between text-amber-100">
            <a href="@Url.Action("HomePage","Home")" class="title-font text-xl tracking-wide">DnDCC</a>
            <nav id="mainNav" class="grid gap-3 text-sm uppercase tracking-wide items-center">
                <a class="nav-link text-center px-3 py-2 rounded-lg border border-amber-900/40 bg-black/30 whitespace-nowrap min-w-[140px]" href="@Url.Action("Index","Home")">Podręczniki</a>
                <a class="nav-link text-center px-3 py-2 rounded-lg border border-amber-900/40 bg-black/30 whitespace-nowrap min-w-[140px]" href="@Url.Action("Dice","Home")">Rzuć kością</a>
                <a id="navMyCharacters" class="nav-link text-center px-3 py-2 rounded-lg border border-amber-900/40 bg-black/30 whitespace-nowrap min-w-[140px] hidden" href="@Url.Action("Index","Character")">Moje postacie</a>
                <a id="navCreateCharacter" class="nav-link text-center px-3 py-2 rounded-lg border border-amber-900/40 bg-black/30 whitespace-nowrap min-w-[140px] hidden" href="@Url.Action("Add","Character")">Stwórz postać</a>
                <div id="helpMenu" class="relative">
                    <button id="helpMenuButton" type="button" class="nav-link w-full text-center px-3 py-2 rounded-lg border border-amber-900/40 bg-black/30 whitespace-nowrap min-w-[140px] flex items-center justify-center gap-1">
                        <i class="fa-solid fa-circle-question"></i>
                        POMOC
                        <span aria-hidden="true" class="text-amber-500 text-xs"></span>
                    </button>
                    <div id="helpMenuPanel" class="hidden absolute right-0 mt-1 w-44 rounded-xl border border-amber-900/25 bg-black/70 text-amber-100 shadow-lg z-50">
                        <a href="@Url.Action("Contact","Home")" class="block px-4 py-2 hover:bg-amber-900/30">KONTAKT</a>
                        <a href="@Url.Action("Faq","Home")" class="block px-4 py-2 hover:bg-amber-900/30">FAQ</a>
                    </div>
                </div>
                <button id="authButton" class="nav-link text-center px-3 py-2 rounded-lg border border-amber-900/40 bg-black/30 whitespace-nowrap min-w-[140px] flex items-center justify-center gap-2">
                    <img src="/images/konto.webp" alt="konto" class="w-4 h-4">
                    <span id="authButtonText">LOGOWANIE/REJESTRACJA</span>
                </button>
            </nav>
        </div>
    </header>
    <main class="site-main flex-1 max-w-6xl mx-auto px-4 py-8">
        <div class="parchment view-shell rounded-2xl p-6 md:p-8">
            @RenderBody()
        </div>
    </main>
    <footer class="site-footer h-[30px] bg-black text-amber-100 flex items-center justify-center text-xs">
        © 2025 All rights reserved by DnDCC. v 1.0
    </footer>

    @if (User?.Identity?.IsAuthenticated == true)
    {
        <div id="dndccChatWidget" class="fixed bottom-6 right-6 z-50 flex items-center gap-3">
            <div id="dndccChatHint" class="chat-hint">Porozmawiaj z DnDCC AI 👋</div>
            <button id="dndccChatButton" class="chat-fab" aria-label="Otworz czat">
                <i class="fa-solid fa-comment-dots text-xl"></i>
            </button>
        </div>

        <div id="dndccChatPanel" class="hidden fixed bottom-24 right-6 z-50 chat-panel">
            <div class="parchment rounded-2xl border border-amber-900/30 shadow-2xl overflow-hidden">
                <div class="flex items-center justify-between px-4 py-3 border-b border-amber-900/20 bg-black/10">
                    <div>
                        <p class="text-xs uppercase tracking-wide text-amber-700">DnDCC AI</p>
                        <p class="text-base text-amber-900">Pomocnik Dungeons & Dragons</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-amber-100 border border-amber-900/30 flex items-center justify-center text-amber-800">
                            <i class="fa-solid fa-robot"></i>
                        </div>
                        <button id="dndccChatClose" class="text-amber-900 text-xl" aria-label="Zamknij">&times;</button>
                    </div>
                </div>
                <div id="dndccChatMessages" class="px-4 py-3 space-y-3 text-base text-amber-900 h-[35vh] overflow-y-auto"></div>
                <div class="border-t border-amber-900/20 px-3 py-3 bg-white/80">
                    <form id="dndccChatForm" class="flex items-center gap-2">
                        <input id="dndccChatInput" class="flex-1 px-3 py-2 rounded-lg border border-amber-900/20 bg-white/90 text-base" placeholder="Zapytaj o DnD..." />
                        <button id="dndccChatSend" class="btn-primary px-3 py-2 rounded-lg text-sm font-semibold border border-amber-900/30" type="submit">Wyślij</button>
                    </form>
                    <div id="dndccChatError" class="hidden mt-2 text-xs text-red-700"></div>
                </div>
            </div>
        </div>
    }

    <!-- Modal auth (login & register) -->
    <div id="authModal" class="hidden fixed inset-0 modal-backdrop z-50 flex items-center justify-center px-4">
        <div class="parchment rounded-2xl w-full max-w-lg relative p-6">
            <button id="closeAuth" class="absolute right-4 top-3 text-amber-800 hover:text-red-700 text-2xl leading-none">&times;</button>
            <div class="flex items-center justify-between mb-4">
                <div>
                    <p class="text-sm uppercase tracking-wide text-amber-700">Gildia bohaterów</p>
                    <h2 id="authTitle" class="title-font text-2xl text-amber-900">Zaloguj się</h2>
                    <p id="authSubtitle" class="text-sm text-amber-800">Podaj login/email i hasło.</p>
                </div>
                <button id="toggleAuth" class="text-sm text-amber-900 underline">Przełącz na rejestrację</button>
            </div>

            <div class="space-y-3" id="authFields">
                <!-- LOGIN/REGISTER FIELDS -->
                <div>
                    <label class="text-sm text-amber-900">Login lub email</label>
                    <input id="authUser" class="w-full mt-1 px-3 py-2 border border-amber-900/20 rounded-lg bg-white/90" />
                </div>
                <div id="authEmailRow" class="hidden">
                    <label class="text-sm text-amber-900">Email</label>
                    <input id="authEmail" class="w-full mt-1 px-3 py-2 border border-amber-900/20 rounded-lg bg-white/90" />
                </div>
                <div class="grid gap-3 md:grid-cols-2 hidden" id="authNameRow">
                    <div>
                        <label class="text-sm text-amber-900">Imię</label>
                        <input id="authFirst" class="w-full mt-1 px-3 py-2 border border-amber-900/20 rounded-lg bg-white/90" />
                    </div>
                    <div>
                        <label class="text-sm text-amber-900">Nazwisko</label>
                        <input id="authLast" class="w-full mt-1 px-3 py-2 border border-amber-900/20 rounded-lg bg-white/90" />
                    </div>
                </div>
                <div>
                    <label class="text-sm text-amber-900">Hasło</label>
                    <input id="authPass" type="password" class="w-full mt-1 px-3 py-2 border border-amber-900/20 rounded-lg bg-white/90" />
                </div>
                <!-- Forgot password link -->
                <div class="text-right">
                    <button id="forgotPassLink" class="text-xs text-amber-800 underline">Zapomniałeś hasła?</button>
                </div>

                <div id="authAlert" class="hidden rounded-lg border border-red-200 bg-red-50 text-red-700 px-3 py-2 text-sm"></div>
                <button id="authSubmit" class="btn-primary w-full py-3 rounded-xl text-sm font-semibold border border-amber-900/30">
                    Wyślij
                </button>
            </div>
        </div>
    </div>

    <!-- Modal: forgot/reset password -->
    <div id="passwordModal" class="hidden fixed inset-0 modal-backdrop z-50 flex items-center justify-center px-4">
        <div class="parchment rounded-2xl w-full max-w-lg relative p-6">
            <button id="closePasswordModal" class="absolute right-4 top-3 text-amber-800 hover:text-red-700 text-2xl leading-none">&times;</button>
            <div class="mb-4">
                <p class="text-sm uppercase tracking-wide text-amber-700">Reset hasła</p>
                <h2 id="passwordModalTitle" class="title-font text-2xl text-amber-900">Wyślij link resetujący</h2>
                <p id="passwordModalSubtitle" class="text-sm text-amber-800">Podaj email konta, a wyślemy token resetu (w wersji dev wypisany jest na konsoli).'</p>
            </div>

            <!-- Step 1: request token -->
            <div id="forgotStep" class="space-y-3">
                <div>
                    <label class="text-sm text-amber-900">Email</label>
                    <input id="forgotEmail" class="w-full mt-1 px-3 py-2 border border-amber-900/20 rounded-lg bg-white/90" />
                </div>
                <div id="forgotAlert" class="hidden rounded-lg border border-red-200 bg-red-50 text-red-700 px-3 py-2 text-sm"></div>
                <button id="sendResetTokenBtn" class="btn-primary w-full py-3 rounded-xl text-sm font-semibold border border-amber-900/30">Wyślij token</button>

                <div class="text-sm text-amber-800">
                    Masz już token? <button id="goToResetStep" class="underline">Przejdź do zmiany hasła</button>
                </div>
            </div>

            <!-- Step 2: reset password with token -->
            <div id="resetStep" class="space-y-3 hidden">
                <div>
                    <label class="text-sm text-amber-900">Email</label>
                    <input id="resetEmail" class="w-full mt-1 px-3 py-2 border border-amber-900/20 rounded-lg bg-white/90" />
                </div>
                <div>
                    <label class="text-sm text-amber-900">Token resetu</label>
                    <input id="resetToken" class="w-full mt-1 px-3 py-2 border border-amber-900/20 rounded-lg bg-white/90" />
                </div>
                <div>
                    <label class="text-sm text-amber-900">Nowe hasło</label>
                    <input id="resetNewPassword" type="password" class="w-full mt-1 px-3 py-2 border border-amber-900/20 rounded-lg bg-white/90" />
                </div>
                <div id="resetAlert" class="hidden rounded-lg border border-red-200 bg-red-50 text-red-700 px-3 py-2 text-sm"></div>
                <button id="resetPasswordBtn" class="btn-primary w-full py-3 rounded-xl text-sm font-semibold border border-amber-900/30">Ustaw nowe hasło</button>

                <div class="text-sm text-amber-800">
                    Nie masz tokenu? <button id="goToForgotStep" class="underline">Wyślij token ponownie</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal user menu -->
    <div id="userModal" class="hidden fixed inset-0 modal-backdrop z-50 flex items-center justify-center px-4">
        <div class="parchment rounded-2xl w-full max-w-md relative p-6 shadow-2xl">
            <button id="closeUser" class="absolute right-4 top-4 text-amber-800 hover:text-red-700 text-3xl leading-none transition-colors">&times;</button>
            
            <!-- Header with avatar and name -->
            <div class="mb-6 text-center">
                <div class="flex justify-center mb-3">
                    <img id="userAvatarPreview" src="/images/konto.webp" alt="avatar" class="w-20 h-20 rounded-full border-2 border-amber-900/30 bg-amber-100 shadow-lg">
                </div>
                <h2 class="title-font text-2xl text-amber-900 mb-1" id="userFullName">Użytkownik</h2>
                <p class="text-sm text-amber-700" id="userNameDisplay"></p>
            </div>

            <!-- Status badge -->
            <div class="mb-6 flex justify-center">
                <div class="rounded-lg border border-amber-900/30 bg-gradient-to-br from-amber-50 to-amber-100 px-4 py-2 shadow-sm">
                    <p class="text-xs text-amber-700 uppercase tracking-wide mb-1 text-center">Status konta</p>
                    <p class="text-center" id="userPremiumBadge">
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-amber-100 border border-amber-900/30 text-amber-900 text-sm font-medium">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z" />
                            </svg>
                            Standard
                        </span>
                    </p>
                </div>
            </div>

            <!-- Personalizacja -->
            <div id="themeSection" class="mb-6">
                <p class="text-xs uppercase tracking-wide text-amber-700 mb-3 font-semibold">Personalizacja</p>
                <div>
                    <label class="text-sm text-amber-900 font-medium">Motyw strony</label>
                    <select id="themeSelect" class="w-full mt-1 px-3 py-2 border border-amber-900/20 rounded-lg bg-white/90">
                        <option value="default">Domyślny</option>
                        <option value="night">Ciemny</option>
                    </select>
                    <p class="text-xs text-amber-700 mt-2">Ustawienie zapisywane dla Twojego konta.</p>
                </div>
            </div>

            <!-- Premium upgrade button (visible only for non-premium users) -->
            <div id="premiumUpgradeSection" class="mb-4">
                <a href="@Url.Action("Premium","Home")" class="block text-center px-4 py-3 rounded-lg border-2 border-amber-500 hover:from-yellow-200 hover:to-amber-300 transition-all shadow-md">
                    <div class="flex items-center justify-center gap-2">
                        <svg class="w-5 h-5 text-amber-700" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        <span class="text-sm font-bold text-amber-900">Ulepsz do Premium</span>
                    </div>
                    <p class="text-xs text-amber-700 mt-1">Odblouj więcej funkcji!</p>
                </a>
            </div>

            <!-- Quick actions -->
            <div class="space-y-2 mb-6">
                <p class="text-xs uppercase tracking-wide text-amber-700 mb-3 font-semibold">Szybkie akcje</p>
                <a href="@Url.Action("Index","Character")" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg border border-amber-900/30 bg-gradient-to-r from-amber-50 to-white hover:from-amber-100 hover:to-amber-50 transition-all shadow-sm">
                    <svg class="w-5 h-5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    <span class="text-sm font-medium text-amber-900">Moje postacie</span>
                </a>
                <a href="@Url.Action("Add","Character")" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg border border-amber-900/30 bg-gradient-to-r from-amber-50 to-white hover:from-amber-100 hover:to-amber-50 transition-all shadow-sm">
                    <svg class="w-5 h-5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    <span class="text-sm font-medium text-amber-900">Stwórz nową postać</span>
                </a>
                <a href="@Url.Action("Index","Home")" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg border border-amber-900/30 bg-gradient-to-r from-amber-50 to-white hover:from-amber-100 hover:to-amber-50 transition-all shadow-sm">
                    <svg class="w-5 h-5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                    <span class="text-sm font-medium text-amber-900">Podręczniki</span>
                </a>
            </div>

            <!-- Logout button -->
            <div class="pt-4 border-t border-amber-900/20">
                <button id="logoutBtn" class="btn-primary w-full py-3 rounded-xl text-sm font-semibold border border-amber-900/30 flex items-center justify-center gap-2 hover:scale-105 transition-transform">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    Wyloguj się
                </button>
            </div>
        </div>
    </div>

    @RenderSection("Scripts", required: false)
    <script>
        const authButton = document.getElementById('authButton');
        const authButtonText = document.getElementById('authButtonText');
        const authModal = document.getElementById('authModal');
        const userModal = document.getElementById('userModal');
        const closeAuthBtn = document.getElementById('closeAuth');
        const closeUserBtn = document.getElementById('closeUser');
        const toggleAuthBtn = document.getElementById('toggleAuth');
        const authTitle = document.getElementById('authTitle');
        const authSubtitle = document.getElementById('authSubtitle');
        const authEmailRow = document.getElementById('authEmailRow');
        const authNameRow = document.getElementById('authNameRow');
        const authSubmit = document.getElementById('authSubmit');
        const authAlert = document.getElementById('authAlert');
        const logoutBtn = document.getElementById('logoutBtn');
        const userFullName = document.getElementById('userFullName');
        const userNameDisplay = document.getElementById('userNameDisplay');
        const mainNav = document.getElementById('mainNav');
        const navMyCharacters = document.getElementById('navMyCharacters');
        const navCreateCharacter = document.getElementById('navCreateCharacter');
        const forgotPassLink = document.getElementById('forgotPassLink');
        const passwordModal = document.getElementById('passwordModal');
        const closePasswordModal = document.getElementById('closePasswordModal');
        const forgotStep = document.getElementById('forgotStep');
        const resetStep = document.getElementById('resetStep');
        const passwordModalTitle = document.getElementById('passwordModalTitle');
        const passwordModalSubtitle = document.getElementById('passwordModalSubtitle');

        const premiumUpgradeSection = document.getElementById('premiumUpgradeSection');
        const userPremiumBadge = document.getElementById('userPremiumBadge');
        const userAvatarPreview = document.getElementById('userAvatarPreview');
        const themeSelect = document.getElementById('themeSelect');

        const sendResetTokenBtn = document.getElementById('sendResetTokenBtn');
        const resetPasswordBtn = document.getElementById('resetPasswordBtn');
        const forgotEmail = document.getElementById('forgotEmail');
        const resetEmail = document.getElementById('resetEmail');
        const resetToken = document.getElementById('resetToken');
        const resetNewPassword = document.getElementById('resetNewPassword');
        const forgotAlert = document.getElementById('forgotAlert');
        const resetAlert = document.getElementById('resetAlert');
        const helpMenu = document.getElementById('helpMenu');
        const helpMenuButton = document.getElementById('helpMenuButton');
        const helpMenuPanel = document.getElementById('helpMenuPanel');

        let mode = 'login';
        let currentUser = null;

        function userThemeStorageKey(user) {
            const identifier = (user?.id || user?.userId || user?.email || user?.userName || 'guest').toString();
            return `dndcc.theme.${identifier}`;
        }

        function readSavedTheme(user) {
            const saved = localStorage.getItem(userThemeStorageKey(user));
            return saved || 'default';
        }

        function saveTheme(user, theme) {
            localStorage.setItem(userThemeStorageKey(user), theme || 'default');
        }

        function applyTheme(theme) {
            const normalized = theme || 'default';
            if (normalized === 'default') {
                delete document.documentElement.dataset.theme;
                return;
            }
            document.documentElement.dataset.theme = normalized;
        }

        function syncThemeUi() {
            if (!themeSelect) return;
            if (!currentUser) {
                themeSelect.value = 'default';
                return;
            }
            themeSelect.value = readSavedTheme(currentUser);
        }

        const fields = {
            user: document.getElementById('authUser'),
            email: document.getElementById('authEmail'),
            first: document.getElementById('authFirst'),
            last: document.getElementById('authLast'),
            pass: document.getElementById('authPass')
        };

        function updateNavigation() {
            if (!mainNav) return;
            mainNav.classList.remove('grid-cols-2', 'grid-cols-3', 'grid-cols-4', 'grid-cols-5', 'grid-cols-6');
            if (currentUser) {
                mainNav.classList.add('grid-cols-6');
                navMyCharacters.classList.remove('hidden');
                navCreateCharacter.classList.remove('hidden');
            } else {
                mainNav.classList.add('grid-cols-4');
                navMyCharacters.classList.add('hidden');
                navCreateCharacter.classList.add('hidden');
            }
        }

        function checkAuth() {
            const userData = localStorage.getItem('user');
            if (userData) {
                currentUser = JSON.parse(userData);
                applyTheme(readSavedTheme(currentUser));
                updateUIForLoggedIn();
            } else {
                applyTheme('default');
            }
            updateNavigation();
        }

        function updateUIForLoggedIn() {
            if (!currentUser) return;
            if (authButtonText) authButtonText.textContent = (currentUser.userName || '').toUpperCase();

            const fullName = `${currentUser.firstName || ''} ${currentUser.lastName || ''}`.trim();
            if (userFullName) userFullName.textContent = fullName || currentUser.userName || 'Użytkownik';
            if (userNameDisplay) userNameDisplay.textContent = (currentUser.userName || 'username');

            const isPrem = Boolean(currentUser.isPremium);
            
            // Show/hide premium upgrade button
            if (premiumUpgradeSection) {
                if (isPrem) {
                    premiumUpgradeSection.classList.add('hidden');
                } else {
                    premiumUpgradeSection.classList.remove('hidden');
                }
            }

            if (userPremiumBadge) {
                userPremiumBadge.innerHTML = isPrem
                    ? `<span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-gradient-to-r from-yellow-200 to-amber-300 border border-amber-900/30 text-amber-900 text-sm font-medium shadow-sm">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        Premium
                    </span>`
                    : `<span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-amber-100 border border-amber-900/30 text-amber-900 text-sm font-medium">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        Standard
                    </span>`;
            }

            if (userAvatarPreview) {
                userAvatarPreview.src = currentUser.avatarUrl || '/images/konto.webp';
            }

            syncThemeUi();
        }

        function setMode(newMode) {
            mode = newMode;
            if (mode === 'login') {
                authTitle.textContent = 'Zaloguj się';
                authSubtitle.textContent = 'Podaj login/email i hasło.';
                authEmailRow.classList.add('hidden');
                authNameRow.classList.add('hidden');
                toggleAuthBtn.textContent = 'Przełącz na rejestrację';
            } else {
                authTitle.textContent = 'Załóż konto';
                authSubtitle.textContent = 'Wypełnij dane nowego bohatera.';
                authEmailRow.classList.remove('hidden');
                authNameRow.classList.remove('hidden');
                toggleAuthBtn.textContent = 'Przełącz na logowanie';
            }
            clearAuthError();
            clearFields();
        }

        function clearFields() {
            fields.user.value = '';
            fields.email.value = '';
            fields.first.value = '';
            fields.last.value = '';
            fields.pass.value = '';
        }

        function showAuthError(msg) {
            authAlert.textContent = msg;
            authAlert.classList.remove('hidden');
        }

        function clearAuthError() {
            authAlert.textContent = '';
            authAlert.classList.add('hidden');
        }

        function showForgot() {
            passwordModalTitle.textContent = 'Wyślij link resetujący';
            passwordModalSubtitle.textContent = 'Podaj email konta, a wyślemy token resetu (w wersji dev wypisany jest na konsoli).';
            forgotStep.classList.remove('hidden');
            resetStep.classList.add('hidden');
        }
        function showReset() {
            passwordModalTitle.textContent = 'Ustaw nowe hasło';
            passwordModalSubtitle.textContent = 'Wpisz email, token resetu i nowe hasło.';
            resetStep.classList.remove('hidden');
            forgotStep.classList.add('hidden');
        }
        function alertForgot(msg) {
            forgotAlert.textContent = msg;
            forgotAlert.classList.remove('hidden');
        }
        function alertReset(msg) {
            resetAlert.textContent = msg;
            resetAlert.classList.remove('hidden');
        }
        function clearForgotAlert() { forgotAlert.textContent = ''; forgotAlert.classList.add('hidden'); }
        function clearResetAlert() { resetAlert.textContent = ''; resetAlert.classList.add('hidden'); }

        authButton?.addEventListener('click', () => {
            if (currentUser) {
                userModal.classList.remove('hidden');
            } else {
                setMode('login');
                authModal.classList.remove('hidden');
            }
        });

        closeAuthBtn?.addEventListener('click', () => authModal.classList.add('hidden'));
        closeUserBtn?.addEventListener('click', () => userModal.classList.add('hidden'));
        authModal?.addEventListener('click', (e) => { if (e.target === authModal) authModal.classList.add('hidden'); });
        userModal?.addEventListener('click', (e) => { if (e.target === userModal) userModal.classList.add('hidden'); });
        toggleAuthBtn?.addEventListener('click', () => setMode(mode === 'login' ? 'register' : 'login'));

        logoutBtn?.addEventListener('click', async () => {
            try {
                await fetch('/api/auth/logout', { method: 'POST' });
            } catch (e) {
                console.error('Logout error:', e);
            }
            localStorage.removeItem('user');
            currentUser = null;
            authButtonText.textContent = 'LOGOWANIE/REJESTRACJA';
            userModal.classList.add('hidden');
            updateNavigation();
            applyTheme('default');
            syncThemeUi();
            location.href = '@Url.Action("Index","Home")';
        });

        themeSelect?.addEventListener('change', () => {
            if (!currentUser) return;
            const theme = themeSelect.value || 'default';
            saveTheme(currentUser, theme);
            applyTheme(theme);
        });

        authSubmit?.addEventListener('click', async () => {
            clearAuthError();
            const user = fields.user?.value.trim();
            const pass = fields.pass?.value;

            if (!user || !pass) {
                showAuthError('Podaj login/email i hasło.');
                return;
            }

            authSubmit.disabled = true;
            authSubmit.textContent = 'Przetwarzanie...';

            if (mode === 'login') {
                try {
                    const res = await fetch('/api/auth/login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ userNameOrEmail: user, password: pass })
                    });

                    if (!res.ok) {
                        const data = await res.json().catch(() => ({}));
                        showAuthError(data.error || 'Błędne dane logowania.');
                        return;
                    }

                    const result = await res.json();
                    localStorage.setItem('user', JSON.stringify(result));
                    currentUser = result;
                    updateUIForLoggedIn();
                    updateNavigation();
                    authModal.classList.add('hidden');
                    clearFields();
                } catch (err) {
                    console.error('Login error:', err);
                    showAuthError('Problem z połączeniem.');
                } finally {
                    authSubmit.disabled = false;
                    authSubmit.textContent = 'Wyślij';
                }
            } else {
                const email = fields.email?.value.trim();
                const first = fields.first?.value.trim();
                const last = fields.last?.value.trim();

                if (!email || !first || !last) {
                    showAuthError('Uzupełnij wszystkie pola.');
                    authSubmit.disabled = false;
                    authSubmit.textContent = 'Wyślij';
                    return;
                }

                try {
                    const res = await fetch('/api/auth/register', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            userName: user,
                            email: email,
                            firstName: first,
                            lastName: last,
                            password: pass,
                            isPremium: false
                        })
                    });

                    if (!res.ok) {
                        const data = await res.json().catch(() => ({}));
                        showAuthError(data.error || 'Nie udało się założyć konta.');
                        return;
                    }

                    const result = await res.json();
                    localStorage.setItem('user', JSON.stringify(result));
                    currentUser = result;
                    updateUIForLoggedIn();
                    updateNavigation();
                    authModal.classList.add('hidden');
                    clearFields();
                } catch (err) {
                    console.error('Register error:', err);
                    showAuthError('Problem z połączeniem.');
                } finally {
                    authSubmit.disabled = false;
                    authSubmit.textContent = 'Wyślij';
                }
            }
        });

        forgotPassLink?.addEventListener('click', () => { showForgot(); passwordModal.classList.remove('hidden'); });
        closePasswordModal?.addEventListener('click', () => { passwordModal.classList.add('hidden'); });

        document.getElementById('goToResetStep')?.addEventListener('click', showReset);
        document.getElementById('goToForgotStep')?.addEventListener('click', showForgot);

        sendResetTokenBtn?.addEventListener('click', async () => {
            clearForgotAlert();
            const email = forgotEmail.value.trim();
            if (!email) { alertForgot('Podaj email.'); return; }
            sendResetTokenBtn.disabled = true;
            sendResetTokenBtn.textContent = 'Wysyłanie...';
            try {
                const res = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                if (!res.ok) {
                    const data = await res.json().catch(() => ({}));
                    alertForgot(data.error || 'Błąd wysyłania tokenu.');
                    return;
                }
                alertForgot('Token został wysłany (sprawdź konsolę serwera).');
                forgotAlert.classList.remove('text-red-700', 'bg-red-50', 'border-red-200');
                forgotAlert.classList.add('text-green-700', 'bg-green-50', 'border-green-200');
            } catch (e) {
                alertForgot('Problem z połączeniem.');
            } finally {
                sendResetTokenBtn.disabled = false;
                sendResetTokenBtn.textContent = 'Wyślij token';
            }
        });

        resetPasswordBtn?.addEventListener('click', async () => {
            clearResetAlert();
            const email = resetEmail.value.trim();
            const token = resetToken.value.trim();
            const newPassword = resetNewPassword.value;
            if (!email || !token || !newPassword) { alertReset('Uzupełnij wszystkie pola.'); return; }
            resetPasswordBtn.disabled = true;
            resetPasswordBtn.textContent = 'Przetwarzanie...';
            try {
                const res = await fetch('/api/auth/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userNameOrEmail: email, token, newPassword })
                });
                if (!res.ok) {
                    const data = await res.json().catch(() => ({}));
                    alertReset(data.error || 'Nie udało się zresetować hasła.');
                    return;
                }
                alertReset('Hasło zostało zaktualizowane. Możesz się zalogować.');
                resetAlert.classList.remove('text-red-700', 'bg-red-50', 'border-red-200');
                resetAlert.classList.add('text-green-700', 'bg-green-50', 'border-green-200');
            } catch (e) {
                alertReset('Problem z połączeniem.');
            } finally {
                resetPasswordBtn.disabled = false;
                resetPasswordBtn.textContent = 'Ustaw nowe hasło';
            }
        });

        helpMenuButton?.addEventListener('click', (e) => {
            e.stopPropagation();
            helpMenuPanel?.classList.toggle('hidden');
        });
        document.addEventListener('click', (e) => {
            if (!helpMenu?.contains(e.target)) {
                helpMenuPanel?.classList.add('hidden');
            }
        });

        checkAuth();
    </script>

    <script>
        (() => {
            const widget = document.getElementById('dndccChatWidget');
            const hasClientUser = !!localStorage.getItem('user');
            if (!hasClientUser) {
                widget?.classList.add('hidden');
                return;
            }
            const panel = document.getElementById('dndccChatPanel');
            const button = document.getElementById('dndccChatButton');
            const closeBtn = document.getElementById('dndccChatClose');
            const hint = document.getElementById('dndccChatHint');
            const messagesEl = document.getElementById('dndccChatMessages');
            const form = document.getElementById('dndccChatForm');
            const input = document.getElementById('dndccChatInput');
            const errorEl = document.getElementById('dndccChatError');

            if (!widget || !panel || !button || !messagesEl || !form || !input) return;

            const messages = [
                { role: 'assistant', content: 'Czesc! Zapytaj mnie o zasady DnD, klasy, zaklecia albo prowadzenie sesji.' }
            ];

            function renderMessages() {
                messagesEl.innerHTML = '';
                messages.forEach(msg => {
                    const item = document.createElement('div');
                    item.className = `chat-message ${msg.role === 'user' ? 'user' : 'assistant'}`;
                    item.textContent = msg.content;
                    messagesEl.appendChild(item);
                });
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }

            function showError(message) {
                if (!errorEl) return;
                errorEl.textContent = message;
                errorEl.classList.remove('hidden');
            }

            function clearError() {
                if (!errorEl) return;
                errorEl.textContent = '';
                errorEl.classList.add('hidden');
            }

            function openChat() {
                panel.classList.remove('hidden');
                if (hint) hint.classList.add('hidden');
                input.focus();
            }

            function closeChat() {
                panel.classList.add('hidden');
                if (hint) hint.classList.remove('hidden');
            }

            button.addEventListener('click', () => {
                if (panel.classList.contains('hidden')) {
                    openChat();
                } else {
                    closeChat();
                }
            });

            closeBtn?.addEventListener('click', closeChat);

            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                clearError();
                const text = input.value.trim();
                if (!text) return;

                messages.push({ role: 'user', content: text });
                input.value = '';
                renderMessages();

                const payload = messages.slice();
                const placeholder = { role: 'assistant', content: '...' };
                messages.push(placeholder);
                renderMessages();

                input.disabled = true;

                try {
                    const res = await fetch('/api/chat/dnd', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ messages: payload })
                    });
                    if (!res.ok) {
                        showError('Nie udalo sie uzyskac odpowiedzi AI.');
                        messages.pop();
                        renderMessages();
                        return;
                    }
                    const data = await res.json();
                    placeholder.content = data.reply || 'Brak odpowiedzi.';
                    renderMessages();
                } catch {
                    showError('Blad polaczenia z AI.');
                    messages.pop();
                    renderMessages();
                } finally {
                    input.disabled = false;
                    input.focus();
                }
            });

            renderMessages();
        })();
    </script>
</body>
</html>
